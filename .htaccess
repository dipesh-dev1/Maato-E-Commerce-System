# Everything is served from /public. Nothing outside it is reachable over HTTP.
Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^$ public/ [L]
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
<FilesMatch "^\.|\.(env|sql|md|log|ini)$">
    Require all denied
</FilesMatch>
