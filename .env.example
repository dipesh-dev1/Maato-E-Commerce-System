# Copy to .env and adjust. Never commit .env.
APP_NAME="Maato"
APP_ENV=local
APP_DEBUG=true
# Full public URL of the site, without trailing slash
APP_URL=http://localhost/suman-ecom
APP_TIMEZONE=Asia/Kathmandu

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=suman-ecom
DB_USERNAME=root
DB_PASSWORD=

# auto = secure cookie only when the request is HTTPS
SESSION_SECURE=auto
SESSION_LIFETIME_MINUTES=120

UPLOAD_MAX_MB=4
